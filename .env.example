# Copy to .env:  cp .env.example .env
# Every value here is a safe LOCAL DEVELOPMENT default. Change secrets before deploying.

# --- Database (used by docker compose) ---
POSTGRES_USER=driveradar
POSTGRES_PASSWORD=driveradar
POSTGRES_DB=driveradar
# Only used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://driveradar:driveradar@localhost:5432/driveradar

# --- Auth ---
# Dev-only signing key. Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0f3c9a7e5b2d4f6a8c1e3b5d7f9a2c4e
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Web ---
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# --- Extraction ---
# mock = offline rule-based extractor (no key needed). Or: openai | anthropic | gemini
LLM_PROVIDER=mock
# Optional model override, e.g. claude-opus-5-5, gpt-4o-mini, gemini-2.5-flash
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# percentage = CGPA x this factor, when a notice gives a UG percentage cut-off
CGPA_TO_PERCENT_FACTOR=10

# --- Demo data ---
SEED_DEMO_DATA=true
